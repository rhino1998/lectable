+    // LECTABLE determinism probe (see breeze speech_decoder.cpp).
+    static thread_local bool lectable_inner = false;
+    if (!lectable_inner) {
+        std::vector<int32_t> cc = codes_in;
+        int64_t fr = frames_in, cb = codebooks;
+        if (const char * lp = std::getenv("LECTABLE_CODES_LOAD")) {
+            std::FILE * f = std::fopen(lp, "rb");
+            std::fread(&fr, 8, 1, f); std::fread(&cb, 8, 1, f);
+            cc.resize(static_cast<size_t>(fr * cb)); std::fread(cc.data(), 4, cc.size(), f); std::fclose(f);
+        }
+        if (const char * dp = std::getenv("LECTABLE_CODES_DUMP")) {
+            std::FILE * f = std::fopen(dp, "wb");
+            std::fwrite(&fr, 8, 1, f); std::fwrite(&cb, 8, 1, f); std::fwrite(cc.data(), 4, cc.size(), f); std::fclose(f);
+        }
+        const char * rp = std::getenv("LECTABLE_REPEAT");
+        const int rep = rp ? std::atoi(rp) : 0;
+        const char * ap = std::getenv("LECTABLE_AUDIO_DUMP");
+        lectable_inner = true;
+        HiggsCodecDecodeOutput out;
+        for (int i = 0; i <= rep; ++i) {
+            const auto t0 = std::chrono::steady_clock::now();
+            auto o = decode_codes(cc, fr, cb);
+            std::fprintf(stderr, "LECTABLE decode %d: %.1f ms for %.2f s audio\n", i, std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count(), o.values.size() / 24000.0);
+            if (ap) {
+                std::string path = std::string(ap) + "." + std::to_string(i);
+                std::FILE * f = std::fopen(path.c_str(), "wb");
+                std::fwrite(o.values.data(), 4, o.values.size(), f); std::fclose(f);
+            }
+            if (i == 0) out = std::move(o);
+        }
+        lectable_inner = false;
+        return out;
+    }
+    const auto & codes = codes_in;
+    const int64_t frames = frames_in;
